# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API key
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# VITE_ADMOB_CLIENT_ID: Google AdMob App ID
VITE_ADMOB_CLIENT_ID="ca-app-pub-1050422776945344~6855047295"

# VITE_ADMOB_SLOT_ID: Google AdMob App Open Ad Unit ID
VITE_ADMOB_SLOT_ID="ca-app-pub-1050422776945344/8752251197"

# VITE_CARTO_API_KEY: Clé API CARTO Basemaps (cartes haute résolution sans filigrane)
VITE_CARTO_API_KEY="cb1_48if_2_0f3fe5e8cce7bab4ee01bfc8"

